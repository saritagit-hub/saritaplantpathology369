############################################################
# SHEET 3 - EFFECT OF Bacillus spp. ON WHOLE PLANT WEIGHT
############################################################

##############################
# Load libraries
##############################

library(readxl)
library(dplyr)
library(ggplot2)
library(agricolae)

############################################################
# IMPORT DATA
#
# Whole Plant Weight is in SHEET 3
############################################################

data <- read_excel(
  "Pthytophthora/Phytophthora_Trial_2_Bacillus.xlsx",
  sheet = 3
)

############################################################
# CHECK IMPORTED DATA
############################################################

cat("\nColumn names in Sheet 3:\n")

print(
  names(data)
)

cat("\nFirst few rows:\n")

print(
  head(data)
)

############################################################
# PREPARE DATA
############################################################

data$Treatment <- as.factor(
  data$Treatment
)

data$Replication <- as.factor(
  data$Replication
)

############################################################
# CHECK THAT WHOLE PLANT WEIGHT COLUMN EXISTS
############################################################

if(!"Whole Plant Weight (gm)" %in% names(data)){
  
  stop(
    paste(
      "\nERROR: 'Whole Plant Weight (gm)' was not found.",
      "\nPlease check the column names printed above."
    )
  )
  
}

############################################################
# CONVERT WHOLE PLANT WEIGHT TO NUMERIC
############################################################

data$`Whole Plant Weight (gm)` <- as.numeric(
  data$`Whole Plant Weight (gm)`
)

############################################################
# ANOVA (RCBD)
############################################################

model <- aov(
  
  `Whole Plant Weight (gm)` ~
    Replication +
    Treatment,
  
  data = data
  
)

############################################################
# ANOVA RESULTS
############################################################

cat("\n==============================\n")
cat("ANOVA - WHOLE PLANT WEIGHT\n")
cat("==============================\n\n")

print(
  summary(model)
)

############################################################
# EXTRACT TREATMENT P-VALUE
############################################################

anova_table <- summary(model)

p_value <- anova_table[[1]][
  "Treatment",
  "Pr(>F)"
]

p_text <- paste0(
  "P = ",
  format.pval(
    p_value,
    digits = 3,
    eps = 0.001
  )
)

############################################################
# LSD TEST
############################################################

LSD <- LSD.test(
  
  model,
  
  "Treatment",
  
  p.adj = "none",
  
  console = TRUE
  
)

############################################################
# EXTRACT LSD GROUPING LETTERS
############################################################

groups <- LSD$groups

groups$Treatment <- rownames(
  groups
)

rownames(groups) <- NULL

############################################################
# SHORTEN LONG LSD GROUP LABELS
############################################################

shorten_groups <- function(x){
  
  sapply(
    
    x,
    
    function(g){
      
      chars <- strsplit(
        as.character(g),
        ""
      )[[1]]
      
      if(length(chars) <= 3){
        
        return(g)
        
      } else {
        
        return(
          paste0(
            chars[1],
            "-",
            chars[length(chars)]
          )
        )
        
      }
      
    }
    
  )
  
}

groups$groups <- shorten_groups(
  groups$groups
)

############################################################
# SUMMARY TABLE
############################################################

summary_data <- data %>%
  
  group_by(Treatment) %>%
  
  summarise(
    
    Mean = mean(
      `Whole Plant Weight (gm)`,
      na.rm = TRUE
    ),
    
    SD = sd(
      `Whole Plant Weight (gm)`,
      na.rm = TRUE
    ),
    
    SE = SD / sqrt(n()),
    
    .groups = "drop"
    
  )

############################################################
# MATCH LSD GROUPS WITH CORRECT TREATMENT
#
# This keeps each LSD letter attached to
# its corresponding treatment.
############################################################

summary_data$Treatment <- as.character(
  summary_data$Treatment
)

groups$Treatment <- as.character(
  groups$Treatment
)

summary_data$groups <- groups$groups[
  
  match(
    summary_data$Treatment,
    groups$Treatment
  )
  
]

############################################################
# CHECK SUMMARY DATA
############################################################

cat("\n==============================\n")
cat("SUMMARY BEFORE ORDERING\n")
cat("==============================\n\n")

print(
  summary_data %>%
    select(
      Treatment,
      Mean,
      SD,
      SE,
      groups
    )
)

############################################################
# ARRANGE BACILLUS ISOLATES ALPHABETICALLY
#
# Bacillus isolates = alphabetical order
# Inoculated Control = after isolates
# Non-inoculated Control = last
#
# Mean, SE and LSD letters remain matched.
############################################################

summary_data <- summary_data %>%
  
  mutate(
    
    Order = case_when(
      
      Treatment == "Inoculated Control" ~ 2,
      
      Treatment == "Non-inoculated Control" ~ 3,
      
      TRUE ~ 1
      
    )
    
  ) %>%
  
  arrange(
    
    Order,
    
    Treatment
    
  ) %>%
  
  select(
    -Order
  )

############################################################
# SET FACTOR LEVELS ACCORDING TO FINAL ORDER
############################################################

summary_data$Treatment <- factor(
  
  summary_data$Treatment,
  
  levels = summary_data$Treatment
  
)

############################################################
# CHECK FINAL ALPHABETICAL ORDER
# AND CORRESPONDING VALUES
############################################################

cat("\n==============================\n")
cat("FINAL ALPHABETICAL ORDER\n")
cat("==============================\n\n")

print(
  summary_data %>%
    select(
      Treatment,
      Mean,
      SE,
      groups
    )
)

############################################################
# DETERMINE Y-AXIS LIMIT
############################################################

y_limit <- max(
  
  summary_data$Mean +
    summary_data$SE
  
) + 5

############################################################
# WHOLE PLANT WEIGHT FIGURE
############################################################

Plant_Weight_Figure <- ggplot(
  
  summary_data,
  
  aes(
    x = Treatment,
    y = Mean
  )
  
) +
  
  ##########################################################
# BARS
##########################################################

geom_col(
  
  fill = "steelblue4",
  
  colour = "black",
  
  width = 0.75
  
) +
  
  ##########################################################
# ERROR BARS - SE
##########################################################

geom_errorbar(
  
  aes(
    
    ymin = Mean - SE,
    
    ymax = Mean + SE
    
  ),
  
  width = 0.20,
  
  linewidth = 0.8
  
) +
  
  ##########################################################
# LSD GROUPING LETTERS
##########################################################

geom_text(
  
  aes(
    
    y = Mean + SE + 2,
    
    label = groups
    
  ),
  
  size = 4,
  
  fontface = "bold"
  
) +
  
  ##########################################################
# P-VALUE
##########################################################

annotate(
  
  "text",
  
  x = Inf,
  
  y = y_limit,
  
  label = p_text,
  
  hjust = 1.1,
  
  vjust = 1,
  
  size = 5,
  
  fontface = "bold"
  
) +
  
  ##########################################################
# Y-AXIS
##########################################################

coord_cartesian(
  
  ylim = c(
    0,
    y_limit
  )
  
) +
  
  ##########################################################
# LABELS
##########################################################

labs(
  
  title = expression(
    
    "Effect of " *
      italic("Bacillus") *
      " spp. on Whole Plant Weight"
    
  ),
  
  x = "Isolates",
  
  y = "Whole Plant Weight (g)"
  
) +
  
  ##########################################################
# THEME
##########################################################

theme_classic(
  
  base_size = 14
  
) +
  
  theme(
    
    plot.title = element_text(
      
      hjust = 0.5,
      
      face = "bold",
      
      size = 16
      
    ),
    
    axis.title = element_text(
      
      face = "bold",
      
      size = 14
      
    ),
    
    axis.text.x = element_text(
      
      angle = 90,
      
      hjust = 1,
      
      vjust = 0.5,
      
      size = 9,
      
      colour = "black"
      
    ),
    
    axis.text.y = element_text(
      
      size = 11,
      
      colour = "black"
      
    ),
    
    axis.line = element_line(
      
      linewidth = 0.8
      
    ),
    
    axis.ticks = element_line(
      
      linewidth = 0.8
      
    ),
    
    legend.position = "none"
    
  )

############################################################
# DISPLAY FIGURE
############################################################

print(
  Plant_Weight_Figure
)

############################################################
# SAVE FIGURE
############################################################

ggsave(
  
  filename = "Plant_Weight_Figure_Alphabetical.png",
  
  plot = Plant_Weight_Figure,
  
  width = 1200,
  
  height = 600,
  
  units = "px",
  
  dpi = 600,
  
  bg = "white"
  
)

############################################################
# END
############################################################
