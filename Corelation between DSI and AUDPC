# ==========================================================
# SPEARMAN'S RANK CORRELATION BETWEEN DSI AND AUDPC
# ========================================

==================

# Install packages if necessary
# install.packages(c("readxl","dplyr","psych","openxlsx"))

library(readxl)
library(dplyr)
library(psych)
library(openxlsx)

# ==========================================================
# FILE PATH
# ==========================================================

  file_path <- "Phytophthora_Trial_1_Bacillus.xlsx"

# ==========================================================
# IMPORT DISEASE SCORING SHEET
# ==========================================================

disease_data <- read_excel(
  path = file_path,
  sheet = "Disease Scoring",
  skip = 1,
  col_names = c(
    "Sample_No",
    "Replication",
    "Day_1",
    "Day_4",
    "Day_7",
    "Day_10",
    "Day_13"
  )
)

# Check imported data
head(disease_data)

# ==========================================================
# CALCULATE DSI (%)
# Disease rating scale = 0-5
# ==========================================================
str(disease_data)
sapply(disease_data, class)
colnames(disease_data)

head(disease_data, 10)

disease_data <- disease_data %>%
  mutate(
    Day_1  = as.numeric(Day_1),
    Day_4  = as.numeric(Day_4),
    Day_7  = as.numeric(Day_7),
    Day_10 = as.numeric(Day_10),
    Day_13 = as.numeric(Day_13)
  )








max_rating <- 5

data_inoc <- disease_data %>%
  mutate(
    DSI = (Day_13 / max_rating) * 100
  )

# ==========================================================
# CALCULATE AUDPC
# ==========================================================

time_points <- c(1, 4, 7, 10, 13)

data_inoc$AUDPC <- apply(
  data_inoc[, c("Day_1","Day_4","Day_7","Day_10","Day_13")],
  1,
  function(x){
    
    sum(
      diff(time_points) *
        (head(x,-1) + tail(x,-1)) / 2
    )
    
  }
)

# ==========================================================
# DATA FOR CORRELATION
# ==========================================================

corr_data <- data_inoc %>%
  select(
    AUDPC,
    DSI
  )

# ==========================================================
# SPEARMAN'S RANK CORRELATION
# ==========================================================

cor_test <- corr.test(
  corr_data,
  method = "spearman",
  adjust = "none"
)

cor_matrix <- cor_test$r
p_matrix   <- cor_test$p

# ==========================================================
# EXPORT RESULTS
# ==========================================================

cor_export <- data.frame(
  Variable = rownames(cor_matrix),
  round(cor_matrix,3),
  check.names = FALSE
)

p_export <- data.frame(
  Variable = rownames(p_matrix),
  round(p_matrix,4),
  check.names = FALSE
)

output_excel <- file.path(
  dirname(file_path),
  "Spearman_Correlation_DSI_AUDPC.xlsx"
)

write.xlsx(
  list(
    Correlation_Coefficients = cor_export,
    P_Values = p_export
  ),
  file = output_excel,
  overwrite = TRUE
)

# ==========================================================
# PRINT RESULTS
# ==========================================================

cat("\n")
cat("=========================================\n")
cat(" Spearman Correlation Completed\n")
cat("=========================================\n\n")

print(cor_matrix)

cat("\nP-values\n")
print(p_matrix)

cat("\nResults exported to:\n")
print(output_excel)
# ==========================================================
# FINAL CORRELATION TABLE
# ==========================================================

final_results <- data.frame(
  Variable_1 = "AUDPC",
  Variable_2 = "DSI",
  Spearman_r = round(cor_test$r[1,2], 3),
  P_value = round(cor_test$p[1,2], 4)
)

final_results
write.xlsx(
  list(
    Final_Result = final_results,
    Correlation_Matrix = cor_export,
    P_Values = p_export
  ),
  file = output_excel,
  overwrite = TRUE
)
